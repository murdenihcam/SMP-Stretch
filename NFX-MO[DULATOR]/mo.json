{
  "id": "org.example.nfx-mo",
  "display_name": "SPACE MOD",
  "category": "NFX",
  "short_label": "MO",
  "machine_version": "0.10",
  "retrigger": "continuous",
  "neighbour": true,
  "description": "Modulated delay on the track before, wet only (blend with the track levels). MODE SPIN pitch-shifting delay (RATE: +-12 semitones, 64 = none; repeats spiral with FB), FLNG flanger, CHOR 3-tap chorus after the Monomachine (RATE = SPD 0.05-10 Hz, FB up to 0.98), DBLR doubler, BODE frequency-shifting delay (RATE: +-1 kHz; DPTH 0 ring modulation ... 127 pure shift). FB up to self-oscillation, SPRD spread, ENTI: a delay envelope fired by TRIG (right: longer then back, left: shorter then back; further = slower; 64 off), DLAY base delay, NBAL blends the track before (right) and two before (left). This build: smooth feedback saturation.",
  "params": [
    {
      "name": "MODE",
      "default": 0,
      "min": 0,
      "max": 4,
      "transform": "index",
      "value_text": [
        {
          "value": 0,
          "text": "SPIN"
        },
        {
          "value": 1,
          "text": "FLNG"
        },
        {
          "value": 2,
          "text": "CHOR"
        },
        {
          "value": 3,
          "text": "DBLR"
        },
        {
          "value": 4,
          "text": "BODE"
        }
      ]
    },
    {
      "name": "RATE",
      "default": 64,
      "transform": "raw14",
      "control": "bipolar"
    },
    {
      "name": "DPTH",
      "default": 64,
      "transform": "unipolar_q23"
    },
    {
      "name": "FB",
      "default": 64,
      "transform": "raw14",
      "control": "bipolar"
    },
    {
      "name": "SPRD",
