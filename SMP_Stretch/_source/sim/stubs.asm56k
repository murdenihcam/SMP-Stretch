; Stand-ins for the firmware sample services, for the Motorola simulator only.
; Everything here sits in internal P memory ($E00...), like the machine itself.
;
; STUB_INFO / STUB_READ behave like the services: the bank 1 (UW) test sample
; lives at X:$4000..., the bank 0 (internal) one at X:$C000...; both have the
; length at X:$7F0 and the Q16.16 native step at X:$7F1.
; Like the real services they keep X0, Y0, R6, R7, M6 and M7, and scramble
; every other register, so a machine relying on anything else fails the test.
;
; FAST_INFO / FAST_READ cost a fixed, measured number of cycles and return
; success without real data. Cycle runs use them, take their cost back out
; and add the documented worst case of each service instead.

        org     p:$e00
STUB_INFO:
        jsr     >TRASH
        move    x:>$7f0,a
        move    x:>$7f1,b
        move    #>$ffffff,x1
        rts

        org     p:$e40
STUB_READ:
        move    #>$4000,n5      ; bank 1 (UW) sample at X:$4000, bank 0 (internal) at X:$C000
        move    x0,b
        tst     b
        bne     SR_BANK
        move    #>$c000,n5
SR_BANK:
        move    n0,b
        move    x:>$7f0,y1
        move    #0,r1
        move    #0,r2
        movec   #>$ffffff,m1
        movec   #>$ffffff,m2
        movec   #>$ffffff,m3
        do      #32,SR_END
        move    y:(r1)+,a
        tst     a
        blt     SR_ZERO
        cmp     y1,a
        bge     SR_ZERO
        tst     b
        ble     SR_ZERO
        move    n5,x1
        add     x1,a
        move    a1,r3
        nop
        move    x:(r3),a
        bra     SR_STORE
SR_ZERO:
        clr     a
SR_STORE:
        move    a,x:(r2)+
        move    #>1,x1
        sub     x1,b
        nop
SR_END:
        jsr     >TRASH
        move    #>1,a
        rts

        org     p:$e80
TRASH:
        move    #>$5a5a5a,x1
        move    #>$5a5a5a,y1
        move    #>$123456,b
        move    #>$a5a5,r0
        move    #>$a5a5,r1
        move    #>$a5a5,r2
        move    #>$a5a5,r3
        move    #>$a5a5,r4
        move    #>$a5a5,r5
        move    #>$a5a5,n0
        move    #>$a5a5,n1
        move    #>$a5a5,n2
        move    #>$a5a5,n3
        move    #>$a5a5,n4
        move    #>$a5a5,n5
        move    #>$a5a5,n6
        move    #>$a5a5,n7
        movec   #>3,m0
        movec   #>3,m1
        movec   #>3,m2
        movec   #>3,m3
        movec   #>3,m4
        movec   #>3,m5
        rts

        org     p:$ec0
FAST_INFO:
        move    x:>$7f0,a
        move    x:>$7f1,b
        rts

        org     p:$ed0
FAST_READ:
        move    #>1,a
        rts

; The test calls each routine from here; DRIVER+1 is patched with the
; routine's address and the simulator stops at DRIVER_DONE.
        org     p:$ef0
DRIVER:
        jsr     >$000000
DRIVER_DONE:
        nop
        nop
