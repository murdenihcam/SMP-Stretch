{
  "id": "org.example.e12-stretch",
  "display_name": "E12 STRETCH",
  "category": "SMP",
  "short_label": "S2",
  "machine_version": "0.6",
  "params": [
    { "name": "PTCH", "default": 64, "transform": "raw14", "control": "bipolar" },
    { "name": "SMPL", "default": 1, "min": 1, "max": 21, "transform": "index" },
    { "name": "DEC", "default": 127, "transform": "raw14", "control": "continuous" },
    { "name": "TIME", "default": 0, "transform": "raw14", "control": "continuous" },
    { "name": "STRT", "default": 0, "transform": "unipolar_q23" },
    { "name": "END", "default": 127, "transform": "unipolar_q23" },
    { "name": "GRAN", "default": 64, "transform": "unipolar_square_q23", "control": "continuous" },
    { "name": "FLUX", "default": 0, "transform": "unipolar_q23", "control": "continuous" }
  ],
  "program": {
    "y_workset_words": 51,
    "relocations": ["TABLE_BASE"],
    "imports": [
      { "symbol": "TRIG_INFO", "abi_symbol": 9 },
      { "symbol": "PCM_A", "abi_symbol": 7 },
      { "symbol": "PCM_B", "abi_symbol": 7 },
      { "symbol": "POSITIONS", "abi_symbol": 8 },
      { "symbol": "READ_SAMPLES", "abi_symbol": 10 }
    ]
  },
  "max_track_cycles": 3500,
  "description": "Internal (E12) sample player with a lo-fi splice time-stretch, same engine as SMP-ST: TIME slows the playback (0 normal, 42 half, 127 frozen) at unchanged pitch, PTCH +-32 semitones (half a semitone per step) independent of speed, DEC decay (127 = none), GRAN grain length (300..5000 samples), FLUX random jitter; END before STRT plays in reverse"
}
